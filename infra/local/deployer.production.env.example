# Copiar a infra/local/deployer.production.env (está en .gitignore) y completar.
# Misma GitHub App que staging; otro rango de puertos y otro mapa.
ORG=plataforma-mvp-jmg
ENTORNO=production
DEPLOYER_CLIENT_ID=
DEPLOYER_CLAVE_PATH=
REGISTRY_DIR=../../registry
MAPA_PATH=../../infra/local/estado/despliegues.production.json
PUERTOS=4500-4599
INTERVALO_SEG=20
MODULO_PLATFORM_JWKS_URL=http://host.docker.internal:8080/.well-known/jwks.json
MODULO_PLATFORM_ISSUER=http://localhost:8080
