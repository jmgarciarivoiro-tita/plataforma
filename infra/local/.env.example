# Copiar a .env (nunca se commitea). Solo valores de desarrollo local.
PG_DEV_PASSWORD=
LOG_LEVEL=info

# Puerto para `pnpm dev` (Docker Compose usa 3000 dentro del contenedor y publica 8080).
PORT=8080

# I1 — identidad (login OIDC con Google)
# URL con la que el navegador llega a la plataforma. El redirect autorizado en Google
# debe ser exactamente: <PLATFORM_URL_PUBLICA>/auth/callback
PLATFORM_URL_PUBLICA=http://localhost:8080
PLATFORM_ISSUER=http://localhost:8080
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Vacío en el MVP (cuenta personal). En la Fase 1.5: dominio de Google Workspace (claim hd).
OIDC_DOMINIO_REQUERIDO=
# Mínimo 32 caracteres aleatorios. PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }) -as [byte[]])
SESSION_SECRET=
SESSION_TTL_MIN=480

# I1-2 — JWT de plataforma (firma ES256). Vacío en local = clave efímera (los tokens
# dejan de valer al reiniciar). Para generar una clave fija:
#   pnpm --filter @plataforma/api generar-clave-jwt
# y pegar la línea completa acá. Es un SECRETO: nunca va al repo.
PLATFORM_JWT_PRIVATE_JWK=
# Solo durante una rotación: JWK pública de la clave anterior.
PLATFORM_JWT_PUBLIC_JWK_ANTERIOR=
ROLES_PROVEEDOR=yaml
ROLES_YAML_PATH=./roles.local.yaml

# I4 — bases de staging y producción (Supabase, conexión directa, P3)
DATABASE_URL_STAGING=
DATABASE_URL_PRODUCTION=
